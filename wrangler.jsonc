// Cloudflare Workers static assets. The app is a static build; no server code.
//   prod: `wrangler deploy`            -> worker "lifey"
//   dev:  `wrangler deploy --env dev`  -> worker "lifey-dev"
// Supabase settings are baked in at build time (VITE_*), so build once per environment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifey",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "dev": {
      "name": "lifey-dev"
    }
  }
}
